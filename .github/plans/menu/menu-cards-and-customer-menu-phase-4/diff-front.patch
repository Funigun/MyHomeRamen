@@ -0,0 +1,101 @@
+@using Microsoft.Extensions.Localization
+@using MyHomeRamen.Blazor.Features.Menu.MenuCards
+@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Models
+@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Shared
+
+@inject IStringLocalizer<MenuCardsResources> Text
+
+<MudStack Spacing="2">
+    <MudText Typo="Typo.subtitle1">@Text["Listings"]</MudText>
+    @if (Section.Offers.Count == 0)
+    {
+        <MudText Typo="Typo.body2" Color="Color.Secondary">@Text["NoListings"]</MudText>
+    }
+    @foreach (MenuCardListingViewModel listing in Section.Offers.OrderBy(offer => offer.SortOrder))
+    {
+        <MudPaper Outlined="true" Class="pa-3">
+            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
+                <MudStack Spacing="1">
+                    <MudText>@listing.Name</MudText>
+                    @if (!listing.IsAvailable)
+                    {
+                        <MudText Typo="Typo.caption" Color="Color.Warning">@Text["UnavailableOffer"]</MudText>
+                    }
+                    else if (listing.Price.HasValue)
+                    {
+                        <MudText Typo="Typo.caption">@Text["OfferPrice", listing.Price.Value.ToString("C")]</MudText>
+                    }
+                </MudStack>
+                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
+                    <MudNumericField T="int"
+                                     @bind-Value="listing.SortOrder"
+                                     Label="@Text["SortOrder"]"
+                                     Variant="Variant.Outlined"
+                                     Disabled="@(!CanEdit)"
+                                     Min="0"
+                                     Style="max-width:100px" />
+                    @if (CanEdit)
+                    {
+                        <MudButton Variant="Variant.Text"
+                                   OnClick="@(() => OnUpdateOffer.InvokeAsync((Section.Id, listing.Id, new UpdateMenuCardOfferRequest(listing.SortOrder))))">
+                            @Text["SaveOrder"]
+                        </MudButton>
+                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
+                                       Color="Color.Error"
+                                       aria-label="@Text["RemoveListing"]"
+                                       OnClick="@(() => OnRemoveOffer.InvokeAsync((Section.Id, listing.Id)))" />
+                    }
+                </MudStack>
+            </MudStack>
+        </MudPaper>
+    }
+    @if (CanEdit)
+    {
+        IReadOnlyList<MenuCardOfferChoiceViewModel> choices = EligibleOffers
+            .Where(offer => Section.Offers.All(listing => listing.OfferId != offer.OfferId))
+            .ToArray();
+        @if (choices.Count == 0)
+        {
+            <MudText Typo="Typo.caption" Color="Color.Secondary">@Text["NoEligibleOffers"]</MudText>
+        }
+        else
+        {
+            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
+                <MudSelect T="Guid" @bind-Value="_selectedOfferId" Label="@Text["Offer"]" Variant="Variant.Outlined">
+                    @foreach (MenuCardOfferChoiceViewModel offer in choices)
+                    {
+                        <MudSelectItem Value="@offer.OfferId">@offer.Name</MudSelectItem>
+                    }
+                </MudSelect>
+                <MudButton Variant="Variant.Outlined"
+                           Color="Color.Primary"
+                           Disabled="@(_selectedOfferId == Guid.Empty)"
+                           OnClick="AddOfferAsync">
+                    @Text["AddOffer"]
+                </MudButton>
+            </MudStack>
+        }
+    }
+</MudStack>
+
+@code {
+    [Parameter, EditorRequired] public MenuCardSectionViewModel Section { get; set; } = default!;
+    [Parameter, EditorRequired] public IReadOnlyList<MenuCardOfferChoiceViewModel> EligibleOffers { get; set; } = [];
+    [Parameter] public bool CanEdit { get; set; }
+    [Parameter, EditorRequired] public EventCallback<(Guid SectionId, AddMenuCardOfferRequest Request)> OnAddOffer { get; set; }
+    [Parameter, EditorRequired] public EventCallback<(Guid SectionId, Guid ListingId, UpdateMenuCardOfferRequest Request)> OnUpdateOffer { get; set; }
+    [Parameter, EditorRequired] public EventCallback<(Guid SectionId, Guid ListingId)> OnRemoveOffer { get; set; }
+
+    private Guid _selectedOfferId;
+
+    private async Task AddOfferAsync()
+    {
+        if (_selectedOfferId == Guid.Empty || Section.Offers.Any(offer => offer.OfferId == _selectedOfferId))
+        {
+            return;
+        }
+
+        int sortOrder = Section.Offers.Count == 0 ? 0 : Section.Offers.Max(offer => offer.SortOrder) + 1;
+        await OnAddOffer.InvokeAsync((Section.Id, new AddMenuCardOfferRequest(_selectedOfferId, sortOrder)));
+    }
+}
