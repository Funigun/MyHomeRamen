@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Components
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Models
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject RestaurantApiClient RestaurantApiClient
@inject IStringLocalizer<RestaurantsResources> Text
@inject NavigationManager NavigationManager

<MudPaper Elevation="3" Class="pa-4 pa-sm-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap gap-2">
        <MudText Typo="Typo.h1">@Text["Heading"]</MudText>
        @if (_canCreate)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateRestaurantAsync">
                @Text["CreateRestaurant"]
            </MudButton>
        }
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["Loading"]</MudText>
        </MudStack>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_loadError.Message</MudAlert>
    }
    else
    {
        <RestaurantsGrid Items="_items"
                         EmptyText='@Text["Empty"]'
                         AddressText='@Text["Address"]'
                         PhoneText='@Text["Phone"]'
                         EmailText='@Text["Email"]'
                         ActiveText='@Text["Active"]'
                         InactiveText='@Text["Inactive"]' />
    }
</MudPaper>

@code {
    private readonly List<RestaurantViewModel> _items = [];
    private readonly ApiErrorState _loadError = new();
    private bool _isLoading = true;
    private bool _canCreate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ApiResult<GetAvailableRestaurantsResponse> result = await RestaurantApiClient.GetAvailableAsync();
            _loadError.Apply(result, Text["LoadError"], Text["LoadError"]);
            if (result is ApiResult<GetAvailableRestaurantsResponse>.Success success)
            {
                (IReadOnlyList<RestaurantViewModel> items, bool canCreate) = RestaurantViewModel.FromResponse(success.Value);
                _items.AddRange(items);
                _canCreate = canCreate;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task CreateRestaurantAsync()
    {
        NavigationManager.NavigateTo(RestaurantRoutes.Create);
        return Task.CompletedTask;
    }
}
