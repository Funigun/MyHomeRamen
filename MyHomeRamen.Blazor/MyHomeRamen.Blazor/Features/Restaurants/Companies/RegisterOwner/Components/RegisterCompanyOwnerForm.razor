@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Restaurants.Companies.RegisterOwner.Models

@inject IStringLocalizer<RegisterCompanyOwnerResources> Text

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue" ValidationDelay="0">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="_model.UserName"
                      For="() => _model.UserName"
                      Error="@HasError(nameof(_model.UserName))"
                      ErrorText="@GetError(nameof(_model.UserName))"
                      Label="@Text["UserName"]"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.FirstName"
                      For="() => _model.FirstName"
                      Error="@HasError(nameof(_model.FirstName))"
                      ErrorText="@GetError(nameof(_model.FirstName))"
                      Label="@Text["FirstName"]"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.LastName"
                      For="() => _model.LastName"
                      Error="@HasError(nameof(_model.LastName))"
                      ErrorText="@GetError(nameof(_model.LastName))"
                      Label="@Text["LastName"]"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.Email"
                      For="() => _model.Email"
                      Error="@HasError(nameof(_model.Email))"
                      ErrorText="@GetError(nameof(_model.Email))"
                      Label="@Text["Email"]"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.PhoneNumber"
                      For="() => _model.PhoneNumber"
                      Error="@HasError(nameof(_model.PhoneNumber))"
                      ErrorText="@GetError(nameof(_model.PhoneNumber))"
                      Label="@Text["PhoneNumber"]"
                      InputType="InputType.Telephone"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.Password"
                      For="() => _model.Password"
                      Error="@HasError(nameof(_model.Password))"
                      ErrorText="@GetError(nameof(_model.Password))"
                      Label="@Text["Password"]"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />

        <MudTextField @bind-Value="_model.ConfirmPassword"
                      For="() => _model.ConfirmPassword"
                      Error="@HasError(nameof(_model.ConfirmPassword))"
                      ErrorText="@GetError(nameof(_model.ConfirmPassword))"
                      Label="@Text["ConfirmPassword"]"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />
    
        <MudTextField @bind-Value="_model.CompanyName"
                      For="() => _model.CompanyName"
                      Error="@HasError(nameof(_model.CompanyName))"
                      ErrorText="@GetError(nameof(_model.CompanyName))"
                      Label="@Text["CompanyName"]"
                      InputType="InputType.Text"
                      Variant="Variant.Outlined"
                      Disabled="_isSubmitting"
                      Immediate="true" />
    
        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="_isSubmitting"
                   OnClick="SubmitAsync">

            @if (_isSubmitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                @Text["Submitting"]
            }
            else
            {
                @Text["Register"]
            }
        </MudButton>
    </MudStack>

    @if (ErrorMessage is not null)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Error" Dense="true">@ErrorMessage</MudAlert>
        </MudItem>
    }
</MudForm>

@code {
    private MudForm _form = default!;
    private readonly RegisterCompanyOwnerModel _model = new();
    private readonly RegisterCompanyOwnerValidator _validator = new();

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } = new Dictionary<string, string[]>();

    [Parameter, EditorRequired]
    public EventCallback<RegisterCompanyOwnerModel> OnSubmit { get; set; }

    private bool _isSubmitting => IsSubmitting;

    private bool HasError(string propertyName) => ValidationErrors.ContainsKey(propertyName);

    private string? GetError(string propertyName) => ValidationErrors.TryGetValue(propertyName, out string[]? errors)
        ? string.Join(" ", errors)
        : null;

    private async Task SubmitAsync()
    {
        await _form.Validate();

        if (IsSubmitting || !_form.IsValid)
        {
            return;
        }

        await OnSubmit.InvokeAsync(_model);
    }
}
