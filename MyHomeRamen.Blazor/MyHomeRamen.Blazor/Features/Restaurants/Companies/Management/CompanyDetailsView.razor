@using MyHomeRamen.Blazor.Features.Restaurants.Companies.Shared

@inject CompanyApiClient CompanyApiClient

<MudPaper Elevation="3" Class="pa-6">
    <MudText Typo="Typo.h1" Class="mb-4">Company Owner Panel</MudText>

    <CompanyOwnerPanelHeader />

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    }
    else if (companyDetails is null)
    {
        <MudText Color="Color.Error">Failed to load company details.</MudText>
    }
    else
    {
        <CompanyDetailsForm CompanyDetails="companyDetails" />
    }
</MudPaper>

@code {
    private CompanyDetailsModel? companyDetails;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        CompanyDetailsDto dto = await CompanyApiClient.GetDetails();
        companyDetails = dto is not null ? CompanyDetailsModel.FromDto(dto) : null;
        isLoading = false;
    }
}
