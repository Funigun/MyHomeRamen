@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Restaurants.Companies.Management.Models
@using MyHomeRamen.Blazor.Features.Restaurants.Companies.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject CompanyApiClient CompanyApiClient
@inject ApiService ApiService
@inject IStringLocalizer<CompanyDetailsResources> Text

<MudPaper Elevation="3" Class="pa-4 pa-md-6">
    <MudText Typo="Typo.h1" Class="mb-4">@Text["Heading"]</MudText>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText>@Text["Loading"]</MudText>
        </MudStack>
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-6">@errorMessage</MudAlert>
    }
    else if (companyDetails is not null)
    {
        <MudStack Spacing="4" Class="mt-6">
            <MudText Typo="Typo.h4">@companyDetails.Name</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">@Text["Description"]</MudText>
                    <MudText>@DisplayValue(companyDetails.Description)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">@Text["LogoUrl"]</MudText>
                    <MudText>@DisplayValue(companyDetails.LogoUrl)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">@Text["LegalName"]</MudText>
                    <MudText>@DisplayValue(companyDetails.BusinessDetails.LegalName)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">@Text["TaxId"]</MudText>
                    <MudText>@DisplayValue(companyDetails.BusinessDetails.TaxId)</MudText>
                </MudItem>
            </MudGrid>

            @if (isEditing)
            {
                <CompanyDetailsForm Model="editModel!"
                                    IsSubmitting="isSubmitting"
                                    ValidationErrors="validationErrors"
                                    OnSubmit="UpdateDetailsAsync"
                                    OnCancel="CancelEdit" />
            }
            else if (CanEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BeginEdit">
                    @Text["Edit"]
                </MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    private CompanyDetailsModel? companyDetails;
    private CompanyDetailsEditModel? editModel;
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isEditing;
    private bool isSubmitting;

    private bool CanEdit => companyDetails?.CanEditCompanyDetails == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDetailsAsync();
    }

    private async Task LoadDetailsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            ApiResult<CompanyDetailsModel> result = await ApiService.ExecuteAsync(
                async () => CompanyDetailsModel.FromResponse(await CompanyApiClient.GetDetailsAsync()));
            ApplyErrors(result);
            companyDetails = result is ApiResult<CompanyDetailsModel>.Success success ? success.Value : null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginEdit()
    {
        if (companyDetails is null || !CanEdit)
        {
            return;
        }

        editModel = CompanyDetailsEditModel.FromDetails(companyDetails);
        isEditing = true;
    }

    private void CancelEdit()
    {
        if (isSubmitting)
        {
            return;
        }

        isEditing = false;
        validationErrors = new Dictionary<string, string[]>();
    }

    private async Task UpdateDetailsAsync(CompanyDetailsEditModel model)
    {
        if (isSubmitting || !CanEdit)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            ApiResult<bool> result = await ApiService.ExecuteAsync(
                () => CompanyApiClient.UpdateDetailsAsync(model.ToRequest()));
            ApplyErrors(result);
            if (result is ApiResult<bool>.Failure failure)
            {
                return;
            }

            await LoadDetailsAsync();
            isEditing = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ApplyErrors<T>(ApiResult<T> result)
    {
        validationErrors = new Dictionary<string, string[]>();
        errorMessage = null;

        if (result is not ApiResult<T>.Failure failure || failure.Error.HandledGlobally)
        {
            return;
        }

        validationErrors = failure.Error.ValidationErrors;
        errorMessage = failure.Error.GeneralError
            ?? (failure.Error.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? Text["ValidationFailure"]
                : failure.Error.Message);
    }

    private string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotProvided"] : value;
}
