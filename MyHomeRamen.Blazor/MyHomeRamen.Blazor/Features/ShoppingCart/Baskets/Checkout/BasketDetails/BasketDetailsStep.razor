@using MyHomeRamen.Blazor.Features.ShoppingCart.Baskets.Checkout
@using MyHomeRamen.Blazor.Features.ShoppingCart.Common.Services

@inject ShoppingCartApiClient ShoppingCartApiClient

<MudCard Class="mt-2">
    <MudCardContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">Your basket</MudText>

            <BasketItemsTable Items="Model.Items"
                              BasketId="Model.BasketId"
                              OnItemsChanged="HandleItemsChangedAsync" />

        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public CheckoutModel Model { get; set; } = default!;

    private Task HandleItemsChangedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
