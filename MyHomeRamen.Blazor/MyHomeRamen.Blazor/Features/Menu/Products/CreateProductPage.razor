@page "/admin/menu/products/create"

@using MyHomeRamen.Blazor.Features.Menu.Common.Services
@using MyHomeRamen.Blazor.Features.Menu.Products.Components
@using MyHomeRamen.Blazor.Infrastructure.Authentication

@attribute [Authorize(Policy = AdminSectionConstants.ProductsManagement)]

@inject MenuNavigationService MenuNavigation

<PageTitle>Create Product</PageTitle>

<MudPaper Elevation="3" Class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-6">Create New Product</MudText>
    <ProductForm Mode="FormMode.Create"
                 OnSuccess="HandleSuccess" />
</MudPaper>

@code {
    private void HandleSuccess(Guid productId)
    {
        MenuNavigation.ToProductDetail(productId);
    }
}
