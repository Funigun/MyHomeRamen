@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Categories.Shared
@using MyHomeRamen.Blazor.Features.Menu.Common.Models
@using MyHomeRamen.Blazor.Features.Menu.Common.Services.Contracts.Categories.Responses
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Shared
@using MyHomeRamen.Blazor.Features.Menu.Products.Components
@using MyHomeRamen.Blazor.Features.Menu.Products.Models
@using MyHomeRamen.Blazor.Features.Menu.Products.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject CategoryApiClient CategoryApiClient
@inject IngredientApiClient IngredientApiClient
@inject ProductsApiClient ProductsApiClient
@inject IStringLocalizer<ProductsResources> Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="page-surface">
    <PageHeader Title='@Text["Heading"]'>
        @if (_allowedActions?.CanCreate == true)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="@ProductsRoutes.Create">
                @Text["Create"]
            </MudButton>
        }
    </PageHeader>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["Loading"]</MudText>
        </MudStack>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@_loadError.Message</MudAlert>
    }
    else
    {
        @if (_actionError.HasError)
        {
            <MudAlert Severity="Severity.Error" Class="page-state">@_actionError.Message</MudAlert>
        }

        @if (_productPendingRetirement is not null)
        {
            <ProductRetirementConfirmation ProductId="_productPendingRetirement.Id"
                                           Message='@Text["RetirementConfirmMessage", _productPendingRetirement.Name]'
                                           ConfirmText='@Text["Retire"]'
                                           ConfirmingText='@Text["Retiring"]'
                                           CancelText='@Text["Cancel"]'
                                           IsSubmitting="_isSubmitting"
                                           OnConfirm="RetireAsync"
                                           OnCancel="CancelRetirement" />
        }

        <ProductTable Items="_items"
                      CanEdit="_allowedActions?.CanEdit == true"
                      CanRetire="_allowedActions?.CanRetire == true"
                      Paging="_paging"
                      OnPageChanged="OnPageChangedAsync"
                      OnEdit="OnEdit"
                      OnRetire="BeginRetirement" />
    }
</MudPaper>

@code {
    private readonly List<ProductViewModel> _items = [];
    private readonly ApiErrorState _loadError = new();
    private readonly ApiErrorState _actionError = new();
    private ProductAllowedActions? _allowedActions;
    private ProductViewModel? _productPendingRetirement;
    private IReadOnlyList<CategoryOption> _categories = [];
    private IReadOnlyList<IngredientOption> _ingredients = [];
    private PageState _paging = PageState.Default();
    private bool _isLoading = true;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
        if (!_loadError.HasError)
        {
            await LoadAsync();
        }
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            ApiResult<GetCategoriesByTypeResponse> categoriesResult =
                await CategoryApiClient.GetByTypeAsync((int)CategoryType.Product);
            if (_loadError.Apply(categoriesResult, Text["LoadError"], Text["UnexpectedError"])
                || categoriesResult is not ApiResult<GetCategoriesByTypeResponse>.Success categoriesSuccess)
            {
                return;
            }

            ApiResult<GetIngredientsForDropdownResponse> ingredientsResult =
                await IngredientApiClient.GetDropdownAsync();
            if (_loadError.Apply(ingredientsResult, Text["LoadError"], Text["UnexpectedError"])
                || ingredientsResult is not ApiResult<GetIngredientsForDropdownResponse>.Success ingredientsSuccess)
            {
                return;
            }

            _categories = categoriesSuccess.Value.Categories
                .Select(category => new CategoryOption(category.Id, category.Name))
                .ToArray();
            _ingredients = ingredientsSuccess.Value.Ingredients
                .Select(ingredient => new IngredientOption(ingredient.Id, ingredient.Name))
                .ToArray();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            ApiResult<GetProductsForManageResponse> result =
                await ProductsApiClient.GetForManageAsync(_paging.CurrentPage, _paging.PageSize);
            _loadError.Apply(result, Text["LoadError"], Text["UnexpectedError"]);

            if (result is ApiResult<GetProductsForManageResponse>.Success success)
            {
                _items.Clear();
                _items.AddRange(success.Value.Products.Select(product =>
                    ProductViewModel.FromResponse(
                        product,
                        _categories,
                        _ingredients,
                        Text["ProductImageAlt"],
                        Text["UnavailableCategory"],
                        Text["UnavailableIngredient"])));
                _allowedActions = success.Value.AllowedActions;
                _paging = _paging with { TotalCount = success.Value.TotalCount };
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _paging = _paging with { CurrentPage = page };
        await LoadAsync();
    }

    private void OnEdit(Guid id)
    {
        if (_allowedActions?.CanEdit == true)
        {
            NavigationManager.NavigateTo(ProductsRoutes.Edit(id));
        }
    }

    private void BeginRetirement(Guid id)
    {
        if (_allowedActions?.CanRetire == true)
        {
            _productPendingRetirement = _items.FirstOrDefault(product =>
                product.Id == id && product.Status == ProductStatusCodes.Active);
            _actionError.Clear();
        }
    }

    private void CancelRetirement() => _productPendingRetirement = null;

    private async Task RetireAsync(Guid id)
    {
        if (_allowedActions?.CanRetire != true || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _actionError.Clear();
        try
        {
            ApiResult<bool> result = await ProductsApiClient.RetireAsync(id);
            if (_actionError.Apply(result, Text["RetirementError"], Text["UnexpectedError"]))
            {
                return;
            }

            _productPendingRetirement = null;
            Snackbar.Add(Text["RetirementSuccess"], Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
