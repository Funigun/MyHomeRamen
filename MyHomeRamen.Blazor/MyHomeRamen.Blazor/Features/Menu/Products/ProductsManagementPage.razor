@page "/admin/menu/products-management"
@layout AdminLayout

@attribute [Authorize(Roles = MenuRoleConstants.Admin)]

@using MyHomeRamen.Blazor.Features.Menu.Categories
@using MyHomeRamen.Blazor.Features.Menu.Categories.Components
@using MyHomeRamen.Common.Contracts.Menu.Categories.DTOs
@using MyHomeRamen.Common.Contracts.Menu.Categories.Requests
@using MyHomeRamen.Blazor.Features.Menu.Common.Constants
@using MyHomeRamen.Blazor.Features.Menu.Common.Models
@using MyHomeRamen.Blazor.Features.Menu.Common.Services
@using MyHomeRamen.Blazor.Features.Menu.Products.Components 
@using MyHomeRamen.Blazor.Common.Models
@using MyHomeRamen.Common.Contracts.Menu.Categories.Responses
@using MyHomeRamen.Common.Contracts.Menu.Products.Responses

@inject MenuApiClient MenuApiClient
@inject MenuNavigationService MenuNavigation
@inject IDialogService DialogService

<PageTitle>Product Categories</PageTitle>

<MudPaper Elevation="3" Class="pa-6">
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">@_successMessage</MudAlert>
    }

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_errorMessage</MudAlert>
    }

    <MudDivider Class="my-6" />

    <MudStack Row="true">
        <MudText Typo="Typo.h5" Class="mb-4" Style="margin: 0px !important; align-content: center">Product Categories</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnAddCategory" />
    </MudStack>

    <CategoryTable Items="_categories" IsLoading="_isLoading" OnDelete="OnCategoryDeletedAsync" OnOrderChanged="OnCategoriesOrderChangedAsync"  />

    <MudDivider Class="my-6" />

    <MudStack Row="true">
        <MudText Typo="Typo.h5" Class="mb-4" Style="margin: 0px !important; align-content: center">Products</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnAddProduct" />
    </MudStack>

    <ProductTable Items="_products"
                  IsLoading="_isProductsLoading"
                  Paging="_productsPaging"
                  OnPageChanged="OnProductPageChangedAsync"
                  OnEdit="OnEditProduct"
                  OnDelete="OnProductDeletedAsync" />

</MudPaper>

@code {
    private List<GetCategoriesByTypeResponse> _categories = [];
    private List<ProductTableModel> _products = [];
    private PageState _productsPaging = PageState.Default();
    private bool _isLoading = true;
    private bool _isProductsLoading = true;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCategoriesAsync(), LoadProductsAsync());
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            IEnumerable<GetCategoriesByTypeResponse> response =
                await MenuApiClient.GetCategoriesByTypeAsync((int)CategoryType.Product);
            _categories = response.ToList();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to load categories. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        _isProductsLoading = true;
        try
        {
            GetProductsForManageResponse? response = await MenuApiClient.GetProductsForManageAsync(
                pageNumber: _productsPaging.CurrentPage,
                pageSize: _productsPaging.PageSize);

            if (response is not null)
            {
                _products = response.Products.Select(ProductTableModel.FromResponse).ToList();
                _productsPaging = _productsPaging with { TotalCount = response.TotalCount };
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to load products. Please try again.";
        }
        finally
        {
            _isProductsLoading = false;
        }
    }

    private async Task OnAddCategory()
    {
        DialogParameters<CategoryFormDialog> p = new DialogParameters<CategoryFormDialog>()
        {
            { z => z.CategoryType, CategoryType.Product },
            { z => z.OnCategoryCreated, EventCallback.Factory.Create<Guid>(this, OnCategoryCreated) }
        };

        DialogOptions dialogOptions = new DialogOptions()
        {
            MaxWidth = MaxWidth.ExtraSmall,
            CloseButton = true,
        };

        await DialogService.ShowAsync<CategoryFormDialog>("Create Category", p, dialogOptions);
    }

    private async Task OnCategoryCreated(Guid id)
    {
        _successMessage = "Category created successfully.";
        await LoadCategoriesAsync();
    }

    private async Task OnCategoriesOrderChangedAsync(List<GetCategoriesByTypeResponse> items)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            List<CategoryOrderItemDto> orderItems = items
                .Select((item, index) => new CategoryOrderItemDto(item.Id, index))
                .ToList();

            UpdateCategoriesOrderRequest request = new(orderItems);
            await MenuApiClient.UpdateCategoriesOrderAsync(request);
            _successMessage = "Category order saved successfully.";
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to save category order. Please try again.";
        }
    }

    private async Task OnCategoryDeletedAsync(Guid id)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            await MenuApiClient.DeleteCategoryAsync(id);
            _successMessage = "Category deleted successfully.";
            await LoadCategoriesAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to delete category. It may still be in use.";
        }
    }

    private async Task OnProductPageChangedAsync(int page)
    {
        _productsPaging = _productsPaging with { CurrentPage = page };
        await LoadProductsAsync();
    }

    private void OnEditProduct(Guid id)
    {
        MenuNavigation.ToEditProduct(id);
    }

    private void OnAddProduct()
    {
        MenuNavigation.ToCreateProduct();
    }

    private async Task OnProductDeletedAsync(Guid id)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            _successMessage = "Product deleted successfully.";
            await LoadProductsAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to delete product. Please try again.";
        }
    }
}
