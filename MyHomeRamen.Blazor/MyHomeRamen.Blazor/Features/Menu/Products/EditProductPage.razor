@page "/admin/menu/products/{Id:guid}/edit"

@using MyHomeRamen.Blazor.Common.Models
@using MyHomeRamen.Blazor.Features.Menu.Categories
@using MyHomeRamen.Blazor.Features.Menu.Common.Constants
@using MyHomeRamen.Blazor.Features.Menu.Common.Models
@using MyHomeRamen.Blazor.Features.Menu.Common.Services
@using MyHomeRamen.Blazor.Features.Menu.Products.Components
@using MyHomeRamen.Common.Contracts.Menu.Categories.Responses
@using MyHomeRamen.Common.Contracts.Menu.Ingredients.Responses

@attribute [Authorize(Roles = MenuRoleConstants.Admin)]

@inject MenuApiClient MenuApiClient
@inject MenuNavigationService MenuNavigation

<PageTitle>Edit Product</PageTitle>

<MudPaper Elevation="3" Class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-6">Edit Product</MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <ProductForm Model="_model" Mode="FormMode.Edit" ProductId="Id" OnSuccess="HandleSuccess" />
    }
</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductModel _model = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var response = await MenuApiClient.GetProductByIdForManageAsync(Id);

        IEnumerable<GetCategoriesByTypeResponse> categoriesResponse = await MenuApiClient.GetCategoriesByTypeAsync((int)CategoryType.Product);
        IEnumerable<CategoryOption> categoryOptions = categoriesResponse.Select(c => new CategoryOption(c.Id, c.Name));

        IEnumerable<GetIngredientsForDropdownResponse> ingredientsResponse = await MenuApiClient.GetIngredientsForDropdownAsync();
        IEnumerable<IngredientOption> ingredientOptions = ingredientsResponse.Select(i => new IngredientOption(i.Id, i.Name));

        if (response is not null)
        {
            _model = ProductModel.FromResponse(response, categoryOptions, ingredientOptions);
        }

        _isLoading = false;
    }

    private void HandleSuccess(Guid id)
    {
        MenuNavigation.ToProductsManagement();
    }
}
