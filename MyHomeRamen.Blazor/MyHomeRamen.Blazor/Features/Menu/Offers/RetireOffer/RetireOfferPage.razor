@attribute [Route(OffersRoutes.RetireTemplate)]
@attribute [Authorize(Policy = AdminSectionConstants.OfferManagement)]
@layout AdminLayout

@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Offers.Shared
@using MyHomeRamen.Blazor.Infrastructure.Authentication

@inject IStringLocalizer<OffersResources> Text

<PageTitle>@Text["RetirePageTitle"]</PageTitle>
<RetireOfferView RestaurantId="RestaurantId" OfferId="OfferId" />

@code {
    [Parameter] public Guid RestaurantId { get; set; }
    [Parameter] public Guid OfferId { get; set; }
}
