@using MyHomeRamen.Blazor.Features.Menu.Common.Services.Contracts.Categories.Responses
@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Categories

@inject IStringLocalizer<CategoryManagementResources> Text

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-2" />
}
else if (Items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-2">@Text["Empty"]</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-2">
            <MudText Style="width: 24px;" />
            <MudText Style="width: 40px;" Typo="Typo.subtitle2">#</MudText>
            <MudText Style="flex: 1;" Typo="Typo.subtitle2">Name</MudText>
            @if (CanDelete)
            {
                <MudText Style="min-width: 88px;" Typo="Typo.subtitle2">@Text["Actions"]</MudText>
            }
        </MudStack>
        <MudDivider />
        @if (CanEdit)
        {
            <MudDropContainer T="CategoryByTypeDto"
                              Items="Items"
                              ItemsSelector="@((_, _) => true)"
                              ItemDropped="OnItemDropped"
                              Class="d-flex flex-column">
                <ChildContent>
                    <MudDropZone T="CategoryByTypeDto" Identifier="items" AllowReorder="true" />
                </ChildContent>
                <ItemRenderer>
                    @CategoryRow(context)
                </ItemRenderer>
            </MudDropContainer>
            @if (_hasPendingChanges && OnOrderChanged.HasDelegate)
            {
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="pa-3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveOrderAsync">@Text["SaveOrder"]</MudButton>
                </MudStack>
            }
        }
        else
        {
            @foreach (CategoryByTypeDto item in Items)
            {
                @CategoryRow(item)
            }
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public List<CategoryByTypeDto> Items { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<List<CategoryByTypeDto>> OnOrderChanged { get; set; }

    private bool _hasPendingChanges;

    private RenderFragment CategoryRow(CategoryByTypeDto item) => @<MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-1">
        @if (CanEdit)
        {
            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                     Size="Size.Small"
                     Style="width: 24px; cursor: grab;"
                     Class="mud-secondary-text" />
        }
        else
        {
            <MudText Style="width: 24px;" />
        }
        <MudText Style="width: 40px;">@(Items.IndexOf(item) + 1)</MudText>
        <MudText Style="flex: 1;">@item.Name</MudText>
        @if (CanDelete)
        {
            <div style="min-width: 88px;">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => OnDelete.InvokeAsync(item.Id))" />
            </div>
        }
    </MudStack>;

    private void OnItemDropped(MudItemDropInfo<CategoryByTypeDto> dropInfo)
    {
        int oldIndex = Items.IndexOf(dropInfo.Item);
        Items.RemoveAt(oldIndex);
        Items.Insert(dropInfo.IndexInZone, dropInfo.Item);

        _hasPendingChanges = true;
    }

    private async Task SaveOrderAsync()
    {
        await OnOrderChanged.InvokeAsync(Items);
        _hasPendingChanges = false;
    }

}
