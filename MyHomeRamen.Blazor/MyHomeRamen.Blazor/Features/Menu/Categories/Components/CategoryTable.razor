@using MyHomeRamen.Blazor.Features.Menu.Common.Models.ApiResponses
@using MyHomeRamen.Blazor.Features.Menu.Common.Services

<MudText Typo="Typo.h5">@Title</MudText>
@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-2" />
}
else if (Items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-2">No @Title.ToLowerInvariant() found.</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-2">
            <MudText Style="width: 24px;" />
            <MudText Style="width: 40px;" Typo="Typo.subtitle2">#</MudText>
            <MudText Style="flex: 1;" Typo="Typo.subtitle2">Name</MudText>
            <MudText Style="min-width: 88px;" Typo="Typo.subtitle2">Actions</MudText>
        </MudStack>
        <MudDivider />
        <MudDropContainer T="GetCategoriesByTypeResponse"
                          Items="Items"
                          ItemsSelector="@((_, _) => true)"
                          ItemDropped="OnItemDropped"
                          Class="d-flex flex-column">
            <ChildContent>
                <MudDropZone T="GetCategoriesByTypeResponse" Identifier="items" AllowReorder="true" />
            </ChildContent>
            <ItemRenderer>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-1">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                             Size="Size.Small"
                             Style="width: 24px; cursor: grab;"
                             Class="mud-secondary-text" />
                    <MudText Style="width: 40px;">@(Items.IndexOf(context) + 1)</MudText>
                    <MudText Style="flex: 1;">@context.Name</MudText>
                    <div style="min-width: 88px;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" />
                    </div>
                </MudStack>
            </ItemRenderer>
        </MudDropContainer>
        @if (_hasPendingChanges && OnOrderChanged.HasDelegate)
        {
            <MudStack Row="true" JustifyContent="JustifyContent.FlexEnd" Class="pa-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveOrderAsync">Save Order</MudButton>
            </MudStack>
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter, EditorRequired] public List<GetCategoriesByTypeResponse> Items { get; set; } = default!;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<List<GetCategoriesByTypeResponse>> OnOrderChanged { get; set; }

    private bool _hasPendingChanges;

    private void OnItemDropped(MudItemDropInfo<GetCategoriesByTypeResponse> dropInfo)
    {
        int oldIndex = Items.IndexOf(dropInfo.Item);
        Items.RemoveAt(oldIndex);
        Items.Insert(dropInfo.IndexInZone, dropInfo.Item);

        _hasPendingChanges = true;
    }

    private async Task SaveOrderAsync()
    {
        await OnOrderChanged.InvokeAsync(Items);
        _hasPendingChanges = false;
    }
}

