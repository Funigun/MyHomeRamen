@using MyHomeRamen.Blazor.Features.Menu.Common.Services.Contracts.Categories.Responses
@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Categories

@inject IStringLocalizer<CategoryManagementResources> Text

@if (Items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="component-empty-state">@Text["Empty"]</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="category-table">
        <div class="category-table-header @(CanDelete ? "with-actions" : string.Empty)">
            <span aria-hidden="true"></span>
            <MudText Typo="Typo.subtitle2">@Text["SortOrder"]</MudText>
            <MudText Typo="Typo.subtitle2" Class="category-table-name">@Text["Name"]</MudText>
            @if (CanDelete)
            {
                <MudText Typo="Typo.subtitle2" Class="category-table-actions">@Text["Actions"]</MudText>
            }
        </div>
        <MudDivider />
        @if (CanEdit)
        {
            <MudDropContainer T="CategoryByTypeDto"
                              Items="Items"
                              ItemsSelector="@((_, _) => true)"
                              ItemDropped="OnItemDropped"
                              Class="category-table-rows">
                <ChildContent>
                    <MudDropZone T="CategoryByTypeDto" Identifier="items" AllowReorder="true" />
                </ChildContent>
                <ItemRenderer>
                    @CategoryRow(context)
                </ItemRenderer>
            </MudDropContainer>
            @if (_hasPendingChanges && OnOrderChanged.HasDelegate)
            {
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="form-actions category-table-save-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveOrderAsync">@Text["SaveOrder"]</MudButton>
                </MudStack>
            }
        }
        else
        {
            @foreach (CategoryByTypeDto item in Items)
            {
                @CategoryRow(item)
            }
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public List<CategoryByTypeDto> Items { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<List<CategoryByTypeDto>> OnOrderChanged { get; set; }

    private bool _hasPendingChanges;

    private RenderFragment CategoryRow(CategoryByTypeDto item) => @<div class="category-table-row @(CanDelete ? "with-actions" : string.Empty)">
        @if (CanEdit)
        {
            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                     Size="Size.Small"
                     Class="category-table-drag-handle mud-secondary-text" />
        }
        else
        {
            <span aria-hidden="true"></span>
        }
        <MudText>@(Items.IndexOf(item) + 1)</MudText>
        <MudText Class="category-table-name">@item.Name</MudText>
        @if (CanDelete)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           Class="category-table-actions"
                           OnClick="@(() => OnDelete.InvokeAsync(item.Id))" />
        }
    </div>;

    private void OnItemDropped(MudItemDropInfo<CategoryByTypeDto> dropInfo)
    {
        int oldIndex = Items.IndexOf(dropInfo.Item);
        Items.RemoveAt(oldIndex);
        Items.Insert(dropInfo.IndexInZone, dropInfo.Item);

        _hasPendingChanges = true;
    }

    private async Task SaveOrderAsync()
    {
        await OnOrderChanged.InvokeAsync(Items);
        _hasPendingChanges = false;
    }

}
