@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.MenuCards
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Components
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Models
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject MenuCardsApiClient MenuCardsApiClient
@inject IStringLocalizer<MenuCardsResources> Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="page-surface">
    <PageHeader Title='@Text["EditHeading"]' />
    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["LoadingDetails"]</MudText>
        </MudStack>
    }
    else if (_invalidRoute)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@Text["InvalidRestaurantContext"]</MudAlert>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@_loadError.Message</MudAlert>
    }
    else if (_details is not null && _formModel is not null)
    {
        @if (!_details.AllowedActions.CanEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="page-state">@Text["NoEditPermission"]</MudAlert>
        }
        else
        {
            @if (_submitError.HasError)
            {
                <MudAlert Severity="Severity.Error" Class="page-state">@_submitError.Message</MudAlert>
            }
            <MenuCardForm Model="_formModel"
                          IsEdit="true"
                          IsSubmitting="_isSubmitting"
                          ErrorMessage="@_submitError.Message"
                          ValidationErrors="_submitError.ValidationErrors"
                          OnSubmit="UpdateAsync"
                          OnCancel="Cancel" />
            <MudDivider Class="my-6" />
            <PageHeader Title="@Text["Sections"]" />
            <MudAlert Severity="Severity.Info" Class="page-state">@Text["PriceExplanation"]</MudAlert>
            <MenuCardSectionsEditor @key="_details"
                                    Sections="_details.Sections"
                                    EligibleOffers="_details.EligibleOffers"
                                    CanEdit="_details.AllowedActions.CanEdit && !_isSubmitting"
                                    OnCreateSection="CreateSectionAsync"
                                    OnUpdateSection="UpdateSectionAsync"
                                    OnDeleteSection="DeleteSectionAsync"
                                    OnAddOffer="AddOfferAsync"
                                    OnUpdateOffer="UpdateOfferAsync"
                                    OnRemoveOffer="RemoveOfferAsync" />
        }
    }
    else if (!_isLoading && !_loadError.HasError && !_invalidRoute)
    {
        <MudAlert Severity="Severity.Warning" Class="page-state">@Text["NotFound"]</MudAlert>
    }
    <MudButton Variant="Variant.Text" Class="mt-4" Href="@MenuCardRoutes.Index(RestaurantId)">@Text["BackToCards"]</MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid RestaurantId { get; set; }
    [Parameter, EditorRequired] public Guid MenuCardId { get; set; }

    private readonly ApiErrorState _loadError = new();
    private readonly ApiErrorState _submitError = new();
    private MenuCardDetailsViewModel? _details;
    private MenuCardFormModel? _formModel;
    private bool _isLoading = true;
    private bool _invalidRoute;
    private bool _isSubmitting;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError.Clear();
        _invalidRoute = false;
        try
        {
            if (RestaurantId == Guid.Empty || MenuCardId == Guid.Empty)
            {
                _invalidRoute = true;
                return;
            }

            ApiResult<GetMenuCardForManageResponse> result =
                await MenuCardsApiClient.GetByIdForManageAsync(MenuCardId, RestaurantId);
            if (_loadError.Apply(result, Text["NotFound"], Text["UnexpectedError"])
                || result is not ApiResult<GetMenuCardForManageResponse>.Success success)
            {
                return;
            }

            if (success.Value.MenuCardId != MenuCardId || success.Value.RestaurantId != RestaurantId)
            {
                _invalidRoute = true;
                return;
            }

            _details = MenuCardDetailsViewModel.FromResponse(success.Value);
            _formModel = MenuCardFormModel.FromResponse(success.Value);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateAsync(MenuCardFormModel model)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateAsync(
                MenuCardId,
                RestaurantId,
                model.ToUpdateRequest());
            if (_submitError.Apply(result, Text["UpdateError"], Text["UnexpectedError"]))
            {
                return;
            }

            Snackbar.Add(Text["UpdateSuccess"], Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CreateSectionAsync(CreateMenuSectionRequest request)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting || string.IsNullOrWhiteSpace(request.Name))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<MenuCardMutationResponse> result =
                await MenuCardsApiClient.CreateSectionAsync(MenuCardId, RestaurantId, request);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateSectionAsync((Guid SectionId, UpdateMenuSectionRequest Request) update)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting || string.IsNullOrWhiteSpace(update.Request.Name))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateSectionAsync(
                MenuCardId,
                update.SectionId,
                RestaurantId,
                update.Request);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeleteSectionAsync(Guid sectionId)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections.All(section => section.Id != sectionId))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.DeleteSectionAsync(MenuCardId, sectionId, RestaurantId);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task AddOfferAsync((Guid SectionId, AddMenuCardOfferRequest Request) addition)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections.All(section => section.Id != addition.SectionId)
            || !_details.EligibleOffers.Any(offer => offer.OfferId == addition.Request.OfferId)
            || _details.Sections
                .First(section => section.Id == addition.SectionId)
                .Offers.Any(offer => offer.OfferId == addition.Request.OfferId))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<MenuCardMutationResponse> result = await MenuCardsApiClient.AddOfferAsync(
                MenuCardId,
                addition.SectionId,
                RestaurantId,
                addition.Request);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateOfferAsync(
        (Guid SectionId, Guid ListingId, UpdateMenuCardOfferRequest Request) update)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections
                .Where(section => section.Id == update.SectionId)
                .All(section => section.Offers.All(offer => offer.Id != update.ListingId)))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateOfferAsync(
                MenuCardId,
                update.SectionId,
                update.ListingId,
                RestaurantId,
                update.Request);
            if (_submitError.Apply(result, Text["OrderError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task RemoveOfferAsync((Guid SectionId, Guid ListingId) removal)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections
                .Where(section => section.Id == removal.SectionId)
                .All(section => section.Offers.All(offer => offer.Id != removal.ListingId)))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.RemoveOfferAsync(
                MenuCardId,
                removal.SectionId,
                removal.ListingId,
                RestaurantId);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        NavigationManager.NavigateTo(MenuCardRoutes.Index(RestaurantId));
        return Task.CompletedTask;
    }
}
