@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.MenuCards
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Components
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Models
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Shared
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject MenuCardsApiClient MenuCardsApiClient
@inject IDialogService DialogService
@inject IStringLocalizer<MenuCardsResources> Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="page-surface menu-card-editor" Outlined="false">
    <PageHeader Title="@(_details?.Name ?? Text["EditHeading"])">
        <TitleContent>
            <div class="menu-card-header-content">
                @if (RestaurantId != Guid.Empty)
                {
                    <div class="menu-card-header-navigation">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   Href="@MenuCardRoutes.Index(RestaurantId)">
                            @Text["BackToCards"]
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="@RestaurantRoutes.Edit(RestaurantId)">
                            @Text["BackToRestaurant"]
                        </MudButton>
                    </div>
                }
                @if (_details is not null && _formModel is not null)
                {
                    <div class="menu-card-header-main">
                        @if (_details.AllowedActions.CanEdit)
                        {
                            <MenuCardForm Model="_formModel"
                                          IsEdit="true"
                                          IsInline="true"
                                          IsSubmitting="_isSubmitting"
                                          ErrorMessage="@_submitError.Message"
                                          ValidationErrors="_submitError.ValidationErrors"
                                          OnSubmit="UpdateAsync"
                                          OnInlineCancel="ClearInlineChanges"
                                          OnCancel="Cancel" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h4">@_details.Name</MudText>
                        }
                        <MudChip T="string"
                                 Color="@(_details.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Outlined">
                            @Text[_details.IsActive ? "Active" : "Inactive"]
                        </MudChip>
                        @if (_details.AllowedActions.CanEdit && !_isSubmitting)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateSectionDialogAsync">
                                @Text["AddSection"]
                            </MudButton>
                        }
                        @if (!_isSubmitting
                            && (_details.IsActive && _details.AllowedActions.CanDelete
                                || !_details.IsActive && _details.AllowedActions.CanEdit))
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="@(_details.IsActive ? Color.Error : Color.Success)"
                                       StartIcon="@(_details.IsActive ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       OnClick="ToggleVisibilityAsync">
                                @Text[_details.IsActive ? "Deactivate" : "Activate"]
                            </MudButton>
                        }
                    </div>
                }
            </div>
        </TitleContent>
    </PageHeader>
    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["LoadingDetails"]</MudText>
        </MudStack>
    }
    else if (_invalidRoute)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@Text["InvalidRestaurantContext"]</MudAlert>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@_loadError.Message</MudAlert>
    }
    else if (_details is not null && _formModel is not null)
    {
        @if (!_details.AllowedActions.CanEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="page-state">@Text["NoEditPermission"]</MudAlert>
        }
        @if (_submitError.HasError)
        {
            <MudAlert Severity="Severity.Error" Class="page-state">@_submitError.Message</MudAlert>
        }
        <MenuCardSectionsEditor @key="_details"
                                Sections="_details.Sections"
                                EligibleOffers="_details.EligibleOffers"
                                CanEdit="_details.AllowedActions.CanEdit && !_isSubmitting"
                                CanDelete="_details.AllowedActions.CanDelete && !_isSubmitting"
                                OnDeleteSection="DeleteSectionAsync"
                                OnUpdateSection="UpdateSectionAsync"
                                OnOrderChanged="UpdateSectionsOrderAsync"
                                OnOpenOfferAssignment="OpenOfferAssignmentDialogAsync"
                                OnUpdateOffer="UpdateOfferAsync"
                                OnRemoveOffer="RemoveOfferAsync" />
    }
    else if (!_isLoading && !_loadError.HasError && !_invalidRoute)
    {
        <MudAlert Severity="Severity.Warning" Class="page-state">@Text["NotFound"]</MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid RestaurantId { get; set; }
    [Parameter, EditorRequired] public Guid MenuCardId { get; set; }

    private readonly ApiErrorState _loadError = new();
    private readonly ApiErrorState _submitError = new();
    private MenuCardDetailsViewModel? _details;
    private MenuCardFormModel? _formModel;
    private bool _isLoading = true;
    private bool _invalidRoute;
    private bool _isSubmitting;
    private Guid? _pendingAssignmentSectionId;
    private readonly HashSet<Guid> _pendingAssignmentOfferIds = [];

    private async Task OpenCreateSectionDialogAsync()
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting)
        {
            return;
        }

        int nextSortOrder = _details.Sections.Count == 0 ? 0 : _details.Sections.Max(section => section.SortOrder) + 1;
        MenuSectionFormModel model = new() { SortOrder = nextSortOrder };
        await ShowSectionDialogAsync(
            Text["AddSectionTitle"],
            model,
            isEdit: false,
            submittedModel => CreateSectionAsync(submittedModel.ToCreateRequest()));
    }

    private async Task ShowSectionDialogAsync(
        string title,
        MenuSectionFormModel model,
        bool isEdit,
        Func<MenuSectionFormModel, Task> onSubmit)
    {
        DialogParameters<MenuSectionDialog> parameters = new()
        {
            { dialog => dialog.Model, model },
            { dialog => dialog.IsEdit, isEdit }
        };
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<MenuSectionDialog>(title, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: MenuSectionFormModel submittedModel })
        {
            await onSubmit(submittedModel);
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError.Clear();
        _invalidRoute = false;
        try
        {
            if (RestaurantId == Guid.Empty || MenuCardId == Guid.Empty)
            {
                _invalidRoute = true;
                return;
            }

            ApiResult<GetMenuCardForManageResponse> result =
                await MenuCardsApiClient.GetByIdForManageAsync(MenuCardId, RestaurantId);
            if (_loadError.Apply(result, Text["NotFound"], Text["UnexpectedError"])
                || result is not ApiResult<GetMenuCardForManageResponse>.Success success)
            {
                return;
            }

            if (success.Value.MenuCardId != MenuCardId || success.Value.RestaurantId != RestaurantId)
            {
                _invalidRoute = true;
                return;
            }

            _details = MenuCardDetailsViewModel.FromResponse(success.Value);
            _formModel = MenuCardFormModel.FromResponse(success.Value);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateAsync(MenuCardFormModel model)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateAsync(
                MenuCardId,
                RestaurantId,
                model.ToUpdateRequest());
            if (_submitError.Apply(result, Text["UpdateError"], Text["UnexpectedError"]))
            {
                return;
            }

            Snackbar.Add(Text["UpdateSuccess"], Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CreateSectionAsync(CreateMenuSectionRequest request)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting || string.IsNullOrWhiteSpace(request.Name))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<MenuCardMutationResponse> result =
                await MenuCardsApiClient.CreateSectionAsync(MenuCardId, RestaurantId, request);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateSectionAsync((Guid SectionId, UpdateMenuSectionRequest Request) update)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting || string.IsNullOrWhiteSpace(update.Request.Name))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateSectionAsync(
                MenuCardId,
                update.SectionId,
                RestaurantId,
                update.Request);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeleteSectionAsync(Guid sectionId)
    {
        if (_details?.AllowedActions.CanDelete != true
            || _isSubmitting
            || _details.Sections.All(section => section.Id != sectionId))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.DeleteSectionAsync(MenuCardId, sectionId, RestaurantId);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenOfferAssignmentDialogAsync(Guid sectionId)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections.All(section => section.Id != sectionId))
        {
            return;
        }

        MenuCardSectionViewModel section = _details.Sections.First(current => current.Id == sectionId);
        if (_pendingAssignmentSectionId != sectionId)
        {
            _pendingAssignmentOfferIds.Clear();
            _pendingAssignmentSectionId = sectionId;
        }

        DialogParameters<MenuCardOfferAssignmentDialog> parameters = new()
        {
            { dialog => dialog.EligibleOffers, _details.EligibleOffers },
            { dialog => dialog.ExistingOfferIds, section.Offers.Select(offer => offer.OfferId).ToArray() },
            { dialog => dialog.SelectedOfferIds, _pendingAssignmentOfferIds.ToArray() }
        };
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<MenuCardOfferAssignmentDialog>(
            Text["AssignOffersTitle"],
            parameters,
            options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: Guid[] offerIds })
        {
            _pendingAssignmentOfferIds.Clear();
            _pendingAssignmentOfferIds.UnionWith(offerIds);
            await AddOffersAsync((sectionId, offerIds));
        }
    }

    private async Task AddOffersAsync((Guid SectionId, IReadOnlyList<Guid> OfferIds) addition)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections.All(section => section.Id != addition.SectionId)
            || _pendingAssignmentSectionId != addition.SectionId)
        {
            return;
        }

        MenuCardSectionViewModel section = _details.Sections.First(current => current.Id == addition.SectionId);
        HashSet<Guid> alreadyListed = section.Offers.Select(offer => offer.OfferId).ToHashSet();
        Guid[] newOfferIds = addition.OfferIds
            .Distinct()
            .Where(offerId => !alreadyListed.Contains(offerId)
                && _details.EligibleOffers.Any(offer => offer.OfferId == offerId))
            .ToArray();
        if (newOfferIds.Length == 0)
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<AddMenuCardOffersResponse> result = await MenuCardsApiClient.AddOffersAsync(
                MenuCardId,
                addition.SectionId,
                RestaurantId,
                new AddMenuCardOffersRequest(newOfferIds));
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            _pendingAssignmentOfferIds.Clear();
            _pendingAssignmentSectionId = null;
            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateOfferAsync(
        (Guid SectionId, Guid ListingId, UpdateMenuCardOfferRequest Request) update)
    {
        if (_details?.AllowedActions.CanEdit != true
            || _isSubmitting
            || _details.Sections
                .Where(section => section.Id == update.SectionId)
                .All(section => section.Offers.All(offer => offer.Id != update.ListingId)))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.UpdateOfferAsync(
                MenuCardId,
                update.SectionId,
                update.ListingId,
                RestaurantId,
                update.Request);
            if (_submitError.Apply(result, Text["OrderError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task RemoveOfferAsync((Guid SectionId, Guid ListingId) removal)
    {
        if (_details?.AllowedActions.CanDelete != true
            || _isSubmitting
            || _details.Sections
                .Where(section => section.Id == removal.SectionId)
                .All(section => section.Offers.All(offer => offer.Id != removal.ListingId)))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = await MenuCardsApiClient.RemoveOfferAsync(
                MenuCardId,
                removal.SectionId,
                removal.ListingId,
                RestaurantId);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateSectionsOrderAsync(IReadOnlyList<MenuCardSectionViewModel> orderedSections)
    {
        if (_details?.AllowedActions.CanEdit != true || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            for (int index = 0; index < orderedSections.Count; index++)
            {
                MenuCardSectionViewModel section = orderedSections[index];
                if (section.SortOrder == index)
                {
                    continue;
                }

                ApiResult<bool> result = await MenuCardsApiClient.UpdateSectionAsync(
                    MenuCardId,
                    section.Id,
                    RestaurantId,
                    new UpdateMenuSectionRequest(section.Name, index));
                if (_submitError.Apply(result, Text["OrderError"], Text["UnexpectedError"]))
                {
                    await LoadAsync();
                    return;
                }
            }

            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ToggleVisibilityAsync()
    {
        if (_details is null || _isSubmitting
            || (_details.IsActive && !_details.AllowedActions.CanDelete)
            || (!_details.IsActive && !_details.AllowedActions.CanEdit))
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<bool> result = _details.IsActive
                ? await MenuCardsApiClient.DeactivateAsync(MenuCardId, RestaurantId)
                : await MenuCardsApiClient.ActivateAsync(MenuCardId, RestaurantId);
            if (_submitError.Apply(result, Text["ActionError"], Text["UnexpectedError"]))
            {
                return;
            }

            Snackbar.Add(
                Text[_details.IsActive ? "DeactivateSuccess" : "ActivateSuccess"],
                Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        NavigationManager.NavigateTo(MenuCardRoutes.Index(RestaurantId));
        return Task.CompletedTask;
    }

    private Task ClearInlineChanges()
    {
        _submitError.Clear();
        return Task.CompletedTask;
    }
}
