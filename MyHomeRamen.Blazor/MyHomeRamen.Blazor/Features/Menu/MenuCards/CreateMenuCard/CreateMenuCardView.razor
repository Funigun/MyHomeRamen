@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.MenuCards
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Components
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Models
@using MyHomeRamen.Blazor.Features.Menu.MenuCards.Shared
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject MenuCardsApiClient MenuCardsApiClient
@inject IStringLocalizer<MenuCardsResources> Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="page-surface menu-card-editor">
    <PageHeader Title='@Text["CreateHeading"]'>
        <TitleContent>
            <div class="menu-card-header-content">
                @if (RestaurantId != Guid.Empty)
                {
                    <div class="menu-card-header-navigation">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   Href="@MenuCardRoutes.Index(RestaurantId)">
                            @Text["BackToCards"]
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="@RestaurantRoutes.Edit(RestaurantId)">
                            @Text["BackToRestaurant"]
                        </MudButton>
                    </div>
                }
                <MudText Typo="Typo.h4" Class="page-header-title">@Text["CreateHeading"]</MudText>
            </div>
        </TitleContent>
    </PageHeader>
    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["LoadingDetails"]</MudText>
        </MudStack>
    }
    else if (_invalidRestaurantContext)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@Text["InvalidRestaurantContext"]</MudAlert>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@_loadError.Message</MudAlert>
    }
    else if (!_canCreate)
    {
        <MudAlert Severity="Severity.Warning" Class="page-state">@Text["NoCreatePermission"]</MudAlert>
    }
    else
    {
        <MenuCardForm Model="_model"
                      IsSubmitting="_isSubmitting"
                      ErrorMessage="@_submitError.Message"
                      ValidationErrors="_submitError.ValidationErrors"
                      OnSubmit="CreateAsync"
                      OnCancel="Cancel" />
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid RestaurantId { get; set; }

    private readonly MenuCardFormModel _model = new();
    private readonly ApiErrorState _loadError = new();
    private readonly ApiErrorState _submitError = new();
    private bool _canCreate;
    private bool _invalidRestaurantContext;
    private bool _isLoading = true;
    private bool _isSubmitting;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        try
        {
            if (RestaurantId == Guid.Empty)
            {
                _invalidRestaurantContext = true;
                return;
            }

            ApiResult<GetMenuCardsForManageResponse> result = await MenuCardsApiClient.GetForManageAsync(RestaurantId);
            if (_loadError.Apply(result, Text["LoadError"], Text["UnexpectedError"])
                || result is not ApiResult<GetMenuCardsForManageResponse>.Success success)
            {
                return;
            }

            _canCreate = success.Value.AllowedActions.CanCreate;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAsync(MenuCardFormModel model)
    {
        if (!_canCreate || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _submitError.Clear();
        try
        {
            ApiResult<MenuCardMutationResponse> result =
                await MenuCardsApiClient.CreateAsync(RestaurantId, model.ToCreateRequest());
            if (_submitError.Apply(result, Text["CreateError"], Text["UnexpectedError"]))
            {
                return;
            }

            Snackbar.Add(Text["CreateSuccess"], Severity.Success);
            NavigationManager.NavigateTo(MenuCardRoutes.Index(RestaurantId));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        NavigationManager.NavigateTo(MenuCardRoutes.Index(RestaurantId));
        return Task.CompletedTask;
    }
}
