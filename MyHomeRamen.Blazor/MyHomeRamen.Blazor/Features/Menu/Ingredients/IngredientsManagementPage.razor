@page "/admin/menu/ingredients-management"
@layout AdminLayout

@attribute [Authorize(Roles = MenuRoleConstants.Admin)]

@using MyHomeRamen.Blazor.Features.Menu.Categories
@using MyHomeRamen.Blazor.Features.Menu.Categories.Components
@using MyHomeRamen.Blazor.Features.Menu.Common.Constants
@using MyHomeRamen.Common.Contracts.Menu.Categories.DTOs
@using MyHomeRamen.Common.Contracts.Menu.Categories.Requests
@using MyHomeRamen.Blazor.Features.Menu.Common.Models
@using MyHomeRamen.Blazor.Features.Menu.Common.Services
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Components
@using MyHomeRamen.Common.Contracts.Menu.Ingredients.Responses
@using MyHomeRamen.Blazor.Common.Models
@using MyHomeRamen.Common.Contracts.Menu.Categories.Responses

@inject MenuApiClient MenuApiClient
@inject MenuNavigationService MenuNavigation
@inject IDialogService DialogService

<PageTitle>Ingredient Categories</PageTitle>

<MudPaper Elevation="3" Class="pa-6">
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">@_successMessage</MudAlert>
    }

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_errorMessage</MudAlert>
    }

    <MudStack Row="true">
        <MudText Typo="Typo.h5" Class="mb-4" Style="margin: 0px !important; align-content: center">Ingredient Categories</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnAddCategory" />
    </MudStack>

    <CategoryTable Items="_categories" IsLoading="_isLoading" OnDelete="OnCategoryDeletedAsync" OnOrderChanged="OnCategoriesOrderChangedAsync" />

    <MudDivider Class="my-6" />

    <MudStack Row="true">
        <MudText Typo="Typo.h5" Class="mb-4" Style="margin: 0px !important; align-content: center">Ingredients</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnAddIngredient"/>
    </MudStack>
        
    <IngredientTable Items="_ingredients"
                     IsLoading="_isIngredientsLoading"
                     Paging="_ingredientsPaging"
                     OnPageChanged="OnIngredientPageChangedAsync"
                     OnEdit="OnEditIngredient"
                     OnDelete="OnIngredientDeletedAsync" />

</MudPaper>

@code {
    private List<GetCategoriesByTypeResponse> _categories = [];
    private List<IngredientTableModel> _ingredients = [];
    private PageState _ingredientsPaging = PageState.Default();
    private bool _isLoading = true;
    private bool _isIngredientsLoading = true;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCategoriesAsync(), LoadIngredientsAsync());
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            IEnumerable<GetCategoriesByTypeResponse> response =
                await MenuApiClient.GetCategoriesByTypeAsync((int)CategoryType.Ingredient);
            _categories = response.ToList();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to load categories. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnCategoryCreated(Guid id)
    {
        _successMessage = "Category created successfully.";
        await LoadCategoriesAsync();
    }

    private async Task OnAddCategory()
    {
        DialogParameters<CategoryFormDialog> p = new DialogParameters<CategoryFormDialog>()
        { 
            { z => z.CategoryType, CategoryType.Ingredient }, 
            { z => z.OnCategoryCreated, EventCallback.Factory.Create<Guid>(this, OnCategoryCreated) } 
        };

        DialogOptions dialogOptions = new DialogOptions()
        {
            MaxWidth = MaxWidth.ExtraSmall,
            CloseButton = true,
        };

        await DialogService.ShowAsync<CategoryFormDialog>("Create Category", p, dialogOptions);
    }

    private async Task OnCategoriesOrderChangedAsync(List<GetCategoriesByTypeResponse> items)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            List<CategoryOrderItemDto> orderItems = items
                .Select((item, index) => new CategoryOrderItemDto(item.Id, index))
                .ToList();

            UpdateCategoriesOrderRequest request = new(orderItems);
            await MenuApiClient.UpdateCategoriesOrderAsync(request);
            _successMessage = "Category order saved successfully.";
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to save category order. Please try again.";
        }
    }

    private async Task OnCategoryDeletedAsync(Guid id)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            await MenuApiClient.DeleteCategoryAsync(id);
            _successMessage = "Category deleted successfully.";
            await LoadCategoriesAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to delete category. It may still be in use.";
        }
    }

    private void OnAddIngredient()
    {
        MenuNavigation.ToCreateIngredient();
    }

    private async Task LoadIngredientsAsync()
    {
        _isIngredientsLoading = true;
        try
        {
            GetIngredientsForManageResponse? response = await MenuApiClient.GetIngredientsForManageAsync(
                pageNumber: _ingredientsPaging.CurrentPage,
                pageSize: _ingredientsPaging.PageSize);

            if (response is not null)
            {
                _ingredients = response.Ingredients.Select(IngredientTableModel.FromResponse).ToList();
                _ingredientsPaging = _ingredientsPaging with { TotalCount = response.TotalCount };
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to load ingredients. Please try again.";
        }
        finally
        {
            _isIngredientsLoading = false;
        }
    }

    private async Task OnIngredientPageChangedAsync(int page)
    {
        _ingredientsPaging = _ingredientsPaging with { CurrentPage = page };
        await LoadIngredientsAsync();
    }

    private void OnEditIngredient(Guid id)
    {
        MenuNavigation.ToEditIngredient(id);
    }

    private async Task OnIngredientDeletedAsync(Guid id)
    {
        _successMessage = null;
        _errorMessage = null;
        try
        {
            await MenuApiClient.DeleteIngredientAsync(id);
            _successMessage = "Ingredient deleted successfully.";
            await LoadIngredientsAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Failed to delete ingredient. Please try again.";
        }
    }
}
