@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Components
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Models
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject IngredientApiClient IngredientApiClient
@inject IStringLocalizer<IngredientsResources> Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="pa-4 pa-sm-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
        <MudText Typo="Typo.h1">@Text["Heading"]</MudText>
        @if (_allowedActions?.CanCreate == true)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="@IngredientRoutes.Create">
                @Text["Create"]
            </MudButton>
        }
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["Loading"]</MudText>
        </MudStack>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_loadError.Message</MudAlert>
    }
    else
    {
        @if (_actionError.HasError)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_actionError.Message</MudAlert>
        }

        <IngredientGrid Items="_items"
                        CanEdit="_allowedActions?.CanEdit == true"
                        CanDelete="_allowedActions?.CanDelete == true"
                        Paging="_paging"
                        EmptyText='@Text["Empty"]'
                        EditText='@Text["Edit"]'
                        DeleteText='@Text["Delete"]'
                        CancelText='@Text["Cancel"]'
                        DeleteConfirmTitle='@Text["DeleteConfirmTitle"]'
                        DeleteConfirmMessage='@Text["DeleteConfirmMessage"]'
                        OnPageChanged="OnPageChangedAsync"
                        OnEdit="OnEdit"
                        OnDelete="OnDeleteAsync" />
    }
</MudPaper>

@code {
    private readonly List<IngredientViewModel> _items = [];
    private readonly ApiErrorState _loadError = new();
    private readonly ApiErrorState _actionError = new();
    private IngredientAllowedActions? _allowedActions;
    private PageState _paging = PageState.Default();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            ApiResult<GetIngredientsForManageResponse> result = await IngredientApiClient.GetForManageAsync(
                _paging.CurrentPage,
                _paging.PageSize);
            _loadError.Apply(result, Text["LoadError"], Text["UnexpectedError"]);

            if (result is ApiResult<GetIngredientsForManageResponse>.Success success)
            {
                _items.Clear();
                _items.AddRange(success.Value.Ingredients.Select(IngredientViewModel.FromResponse));
                _allowedActions = success.Value.AllowedActions;
                _paging = _paging with { TotalCount = success.Value.TotalCount };
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _paging = _paging with { CurrentPage = page };
        await LoadAsync();
    }

    private void OnEdit(Guid id)
    {
        if (_allowedActions?.CanEdit == true)
        {
            NavigationManager.NavigateTo(IngredientRoutes.Edit(id));
        }
    }

    private async Task OnDeleteAsync(Guid id)
    {
        if (_allowedActions?.CanDelete != true)
        {
            return;
        }

        _actionError.Clear();
        ApiResult<bool> result = await IngredientApiClient.DeleteAsync(id);
        if (_actionError.Apply(result, Text["UnexpectedError"], Text["UnexpectedError"]))
        {
            if (_actionError.HasError)
            {
                Snackbar.Add(_actionError.Message!, Severity.Error);
            }

            return;
        }

        Snackbar.Add(Text["DeleteSuccess"], Severity.Success);
        await LoadAsync();
    }
}
