@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Menu.Ingredients.Models
@using MyHomeRamen.Blazor.Features.Menu.Ingredients

@inject IStringLocalizer<IngredientsResources> Text

<MudForm @ref="_form" Model="Model" Validation="_validator.ValidateValue" ValidationDelay="0">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="Model.Name"
                      For="@(() => Model.Name)"
                      Label="@Text["Name"]"
                      Variant="Variant.Outlined"
                      Disabled="IsSubmitting"
                      Error="@HasError(nameof(Model.Name))"
                      ErrorText="@GetError(nameof(Model.Name))" />
        <MudTextField @bind-Value="Model.Description"
                      For="@(() => Model.Description)"
                      Label="@Text["Description"]"
                      Variant="Variant.Outlined"
                      Lines="4"
                      Disabled="IsSubmitting"
                      Error="@HasError(nameof(Model.Description))"
                      ErrorText="@GetError(nameof(Model.Description))" />
        <MudNumericField @bind-Value="Model.Price"
                         For="@(() => Model.Price)"
                         Label="@Text["Price"]"
                         Variant="Variant.Outlined"
                         Adornment="Adornment.Start"
                         AdornmentText="$"
                         Min="0.0m"
                         Max="50.0m"
                         Disabled="IsSubmitting"
                         Error="@HasError(nameof(Model.Price))"
                         ErrorText="@GetError(nameof(Model.Price))" />
        <MudSelect T="Guid"
                   @bind-SelectedValues="Model.CategoryIds"
                   Label="@Text["Categories"]"
                   MultiSelection="true"
                   Variant="Variant.Outlined"
                   Disabled="IsSubmitting"
                   Error="@HasError(nameof(Model.CategoryIds))"
                   ErrorText="@GetError(nameof(Model.CategoryIds))">
            @foreach (IngredientCategoryOption category in Categories)
            {
                <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@ErrorMessage</MudAlert>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="flex-wrap">
            <MudButton Variant="Variant.Text" Disabled="IsSubmitting" OnClick="CancelAsync">@Text["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsSubmitting" OnClick="SubmitAsync">
                @if (IsSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    @Text["Saving"]
                }
                else
                {
                    @Text[IsEdit ? "Save" : "Create"]
                }
            </MudButton>
        </MudStack>
    </MudStack>
</MudForm>

@code {
    [Parameter, EditorRequired] public IngredientFormModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<IngredientCategoryOption> Categories { get; set; } = [];
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } = new Dictionary<string, string[]>();
    [Parameter, EditorRequired] public EventCallback<IngredientFormModel> OnSubmit { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

    private MudForm _form = default!;
    private IngredientFormModelValidator _validator = default!;

    protected override void OnInitialized()
    {
        _validator = new IngredientFormModelValidator(Text);
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || IsSubmitting)
        {
            return;
        }

        await OnSubmit.InvokeAsync(Model);
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private bool HasError(string propertyName) => GetError(propertyName) is not null;

    private string? GetError(string propertyName)
    {
        IEnumerable<string> errors = ValidationErrors
            .Where(error => error.Key.Equals(propertyName, StringComparison.Ordinal)
                || error.Key.EndsWith($".{propertyName}", StringComparison.Ordinal))
            .SelectMany(error => error.Value);

        string[] fieldErrors = errors.ToArray();
        return fieldErrors.Length > 0 ? string.Join(" ", fieldErrors) : null;
    }
}
