@using MyHomeRamen.Blazor.Common.Configuration
@using MyHomeRamen.Blazor.Common.Models
@using MyHomeRamen.Blazor.Features.Home.Models
@using MyHomeRamen.Blazor.Components.Common

@inject RestaurantConfiguration RestaurantConfiguration

@if (Model is not null)
{
    <section class="location-section">
        <MudGrid Class="location-grid">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="location-address-card">
                    <MudText Typo="Typo.h6" Class="location-find-us">Find Us</MudText>
                    <MudText Typo="Typo.body2" Class="location-address">@RestaurantConfiguration.LocationAddress</MudText>
                    <div class="location-map-wrapper">
                        <ImageDisplay
                            Image="@(new ImageModel { Url = RestaurantConfiguration.LocationMapImageUrl, Alt = "Map" })"
                            Class="location-map-image"
                            Style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%); opacity:0.5;" />
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="8">
                <div class="location-atmosphere-wrapper">
                    <ImageDisplay
                        Image="Model.AtmosphereImage"
                        Class="location-atmosphere-image"
                        Style="width:100%; height:100%; object-fit:cover;" />
                    <MudPaper Elevation="4" Class="location-atmosphere-card">
                        <MudText Typo="Typo.h5" Class="location-atmosphere-title">@Model.Title</MudText>
                        <MudText Typo="Typo.body2" Class="location-atmosphere-description">@Model.Description</MudText>
                    </MudPaper>
                </div>
            </MudItem>
        </MudGrid>
    </section>
}

@code {
    [Parameter, EditorRequired] public AtmosphereSectionModel? Model { get; set; }
}
