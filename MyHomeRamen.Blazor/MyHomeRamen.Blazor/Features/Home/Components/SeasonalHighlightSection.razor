@using MyHomeRamen.Blazor.Features.Home.Models
@using MyHomeRamen.Blazor.Components.Common

@if (Model is not null)
{
    <section class="seasonal-section">
        <MudGrid Class="seasonal-grid">
            <MudItem xs="12" md="6" Class="seasonal-content">
                <MudText Typo="Typo.overline" Class="seasonal-label">@Model.Label</MudText>
                <MudText Typo="Typo.h4" Class="seasonal-title">@Model.Title</MudText>
                <MudText Typo="Typo.body1" Class="seasonal-description">@Model.Description</MudText>
                @if (!string.IsNullOrEmpty(Model.LinkText))
                {
                    <MudLink Href="@Model.LinkHref" Color="Color.Primary" Class="seasonal-link">
                        @Model.LinkText
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="ml-2" />
                    </MudLink>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="seasonal-image-wrapper">
                    <MudPaper Elevation="6" Class="seasonal-image-frame">
                        <ImageDisplay Image="Model.Image" Class="seasonal-image" Style="width:100%; height:100%; object-fit:cover;" />
                    </MudPaper>
                    <div class="seasonal-image-border"></div>
                </div>
            </MudItem>
        </MudGrid>
    </section>
}

@code {
    [Parameter, EditorRequired] public SeasonalHighlightSectionModel? Model { get; set; }
}
