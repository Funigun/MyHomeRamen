@using Microsoft.Extensions.Localization
@using MyHomeRamen.Blazor.Features.Admin.CompanyOwnerHome
@using MyHomeRamen.Blazor.Features.Menu.RestaurantMenu.Shared
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Models
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Shared
@using MyHomeRamen.Blazor.Infrastructure.Api

@inject RestaurantApiClient RestaurantApiClient
@inject IStringLocalizer<CompanyOwnerHomeResources> Text

<MudPaper Elevation="3" Class="page-surface">
    <PageHeader Title='@Text["Heading"]'>
        @if (_canCreate)
        {
            <MudButton Href="@RestaurantRoutes.Create"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                @Text["CreateRestaurant"]
            </MudButton>
        }
    </PageHeader>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@Text["Loading"]</MudText>
        </MudStack>
    }
    else if (_loadError.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="page-state">@_loadError.Message</MudAlert>
    }
    else if (_restaurants.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="page-state">@Text["Empty"]</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (RestaurantViewModel restaurant in _restaurants)
            {
                <MudItem @key="restaurant.Id" xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@restaurant.Name</MudText>
                            <MudText Typo="Typo.body2">@restaurant.Address</MudText>
                            <MudText Typo="Typo.caption">
                                @(restaurant.IsActive ? Text["Active"] : Text["Inactive"])
                            </MudText>
                        </MudCardContent>
                        <MudCardActions Class="flex-wrap">
                            <MudButton Href="@RestaurantRoutes.Edit(restaurant.Id)"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary">
                                @Text["ManageRestaurant"]
                            </MudButton>
                            <MudButton Href="@RestaurantMenuRoutes.CompanyOwnerPreview(restaurant.Id)"
                                       Variant="Variant.Text"
                                       Color="Color.Primary">
                                @Text["PreviewMenu"]
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private readonly ApiErrorState _loadError = new();
    private IReadOnlyList<RestaurantViewModel> _restaurants = [];
    private bool _canCreate;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ApiResult<GetAvailableRestaurantsResponse> result = await RestaurantApiClient.GetAvailableAsync();
            if (_loadError.Apply(result, Text["LoadError"], Text["UnexpectedError"]))
            {
                return;
            }

            if (result is ApiResult<GetAvailableRestaurantsResponse>.Success success)
            {
                (IReadOnlyList<RestaurantViewModel> restaurants, bool canCreate) =
                    RestaurantViewModel.FromResponse(success.Value);
                _restaurants = restaurants;
                _canCreate = canCreate;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
