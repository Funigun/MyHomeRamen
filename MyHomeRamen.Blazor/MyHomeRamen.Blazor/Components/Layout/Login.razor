@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.body2" Color="Color.Inherit">
                Welcome @context.User.Identity?.Name!
            </MudText>
            <form method="post" action="authentication/logout" style="display:inline;">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">
                    Logout
                </MudButton>
            </form>
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="authentication/login" Variant="Variant.Text" Color="Color.Inherit">
            Login
        </MudButton>
    </NotAuthorized>
</AuthorizeView>