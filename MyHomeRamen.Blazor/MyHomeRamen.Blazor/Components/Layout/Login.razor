@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <form method="post" action="authentication/logout" style="display:inline;">
                <AntiforgeryToken />
                <MudIconButton Icon="@Icons.Material.Filled.Logout" ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" />
            </form>
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudIconButton Icon="@Icons.Material.Filled.Login" Href="authentication/login" Variant="Variant.Text" Color="Color.Inherit"/>
    </NotAuthorized>
</AuthorizeView>