@using MyHomeRamen.Blazor.Infrastructure.Authentication.StateProvider

@inherits LayoutComponentBase

@inject ThemeProviderService ThemeProvider
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <MudLayout Class="site-layout">
        <AppBar />

        <MudMainContent>
            <div class="app-page-content">
                @Body
            </div>
        </MudMainContent>
    
         <div class="site-footer">
            <Footer />
         </div>
    </MudLayout>
</CascadingAuthenticationState>

@code {
    private MudTheme _theme = default!;

    private bool _showDrawer = false;
    private bool _openDrawer = false;
    private string _userName = string.Empty;

    protected override void OnInitialized() => _theme = ThemeProvider.GetTheme();

    protected override async Task OnInitializedAsync()
    {
        _userName = await AuthenticationStateProvider.GetUserName() ?? string.Empty;
    }
}