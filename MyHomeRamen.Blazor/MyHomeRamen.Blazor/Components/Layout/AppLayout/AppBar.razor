@using MyHomeRamen.Blazor.Features.Account.Common.Services;
@using MyHomeRamen.Blazor.Features.Admin.Common.Services;
@using MyHomeRamen.Blazor.Features.Home.Common.Services
@using MyHomeRamen.Blazor.Features.ShoppingCart.Baskets.BasketMenu
@using MyHomeRamen.Blazor.Features.Restaurants.Restaurants.Shared
@using MyHomeRamen.Blazor.Infrastructure.Authentication.StateProvider


@inject RestaurantConfiguration RestaurantConfiguration
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudAppBar Elevation="1">
    <div class="app-bar-content">
        <div class="app-bar-title">
            <MudText Typo="Typo.h3">@RestaurantConfiguration.RestaurantName</MudText>
        </div>
        <div class="app-bar-navigation">
            <div class="app-bar-menu">
                <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate(HomeNavigationService.Routes.Home))">Home</MudButton>
                <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate(RestaurantRoutes.BrowseRestaurants))">Menu</MudButton>
            </div>

            <div class="app-bar-actions">
                @if (_canViewAdminPanel)
                {
                    <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate(AdminNavigationService.Routes.SelectRestaurant))">Admin Panel</MudButton>
                }

                <BasketSummaryMenu />

                @if (_isAuthenticated)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate(AccountNavigationService.Routes.AccountManagement))">Account</MudIconButton>
                }

                <Login />
            </div>
        </div>
    </div>
</MudAppBar>

@code {
    private bool _isAuthenticated = false;
    private string _userName = string.Empty;
    private bool _canViewAdminPanel;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthenticationStateProvider.IsAuthenticated();
        _canViewAdminPanel = await AuthenticationStateProvider.CanViewAdminPanel();
    }

    private void Navigate(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}