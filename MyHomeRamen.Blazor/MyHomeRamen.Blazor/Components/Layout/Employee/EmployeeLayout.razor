@inherits LayoutComponentBase

@using MyHomeRamen.Blazor.Common.Configuration
@using MyHomeRamen.Blazor.Components.Common
@using MyHomeRamen.Blazor.Features.Menu.Common.Services

@inject ThemeProviderService ThemeProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Style="--mud-appbar-height: 175px; --footer-height: 181px;">
    <EmployeeAppBar OnAdminPanelShowChanged="@(show => _showDrawer = show)" 
                    OnAdminPanelShowNavMenuChanged="@(showMenu => _openDrawer = showMenu)"
    />

    @if (_showDrawer)
    {
        <MudDrawer @bind-Open="_openDrawer" Style="max-width: 250px; overflow: hidden" Overlay="false" ClipMode="DrawerClipMode.Docked" Elevation="1" Variant="@DrawerVariant.Mini">
            <MudPaper Width="240px" Style="height: calc(100vh - 175px - var(--footer-height)); overflow-y: hidden; overflow: auto;">
                <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="mud-width-full pa-2" Style="width: 230px">
                    <MudNavGroup Title="Menu Management" Icon="@Icons.Material.Filled.RestaurantMenu" IconColor="Color.Secondary">
                        <MudNavLink Href="@MenuNavigationService.Routes.Admin.ProductsManagement">Products Management</MudNavLink>
                        <MudNavLink Href="@MenuNavigationService.Routes.Admin.IngredientsManagement">Ingredients Management</MudNavLink>
                    </MudNavGroup>
                </MudNavMenu>
            </MudPaper>
        </MudDrawer>
    }

    <MudMainContent>
        <div style="min-height: 900px; padding: 96px 48px; padding-bottom: var(--footer-height);">
            @Body
        </div>
        
    </MudMainContent>

     <div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 999;">
        <Footer />
     </div>
</MudLayout>

@code {
    private MudTheme _theme = default!;

    private bool _showDrawer = false;
    private bool _openDrawer = false;

    protected override void OnInitialized() => _theme = ThemeProvider.GetTheme();
}