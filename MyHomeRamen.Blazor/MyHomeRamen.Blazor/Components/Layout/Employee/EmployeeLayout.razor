@inherits LayoutComponentBase

@using MyHomeRamen.Blazor.Common.Configuration

@inject RestaurantConfiguration RestaurantConfiguration

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudStack>
            <span>@RestaurantConfiguration.RestaurantName - Customer</span>
            <MudStack Row="true">
                <MudIconButton Href="/menu" Color="Color.Primary" Edge="Edge.Start">Menu</MudIconButton>
                <MudIconButton Href="/products" Color="Color.Primary" Edge="Edge.Start">Products</MudIconButton>
                <MudIconButton Href="/orders" Color="Color.Primary" Edge="Edge.Start">Orders</MudIconButton>
                <MudIconButton Href="/reservations" Color="Color.Primary" Edge="Edge.Start">Reservations</MudIconButton>
                <MudIconButton Href="/tables" Color="Color.Primary" Edge="Edge.Start">Tables</MudIconButton>

                <MudSpacer />

                <MudIconButton Href="/account" Color="Color.Primary" Edge="Edge.Start">Account</MudIconButton>
                <MudIconButton Color="Color.Primary" Edge="Edge.Start">Sign-out</MudIconButton>
            </MudStack>
        </MudStack>
    </MudAppBar>
</MudLayout>

