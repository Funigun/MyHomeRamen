@using MyHomeRamen.Blazor.Common.Configuration

@inject RestaurantConfiguration RestaurantConfiguration
@inject NavigationManager NavigationManager

<MudAppBar Elevation="1">
    <MudStack Style="width:100%;align-self: center;">
        <MudText Typo="Typo.h3" Style="text-align:center; margin-top: 50px">@RestaurantConfiguration.RestaurantName</MudText>
        <MudStack Row="true" Style="align-items: center;">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleAdminMenu" />
            <MudSpacer />
            <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/menu"))">Menu</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/admin-panel"))">Admin Panel</MudButton>
            <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/account"))">Account</MudButton>
            <Login />
        </MudStack>
    </MudStack>
</MudAppBar>

@code {
    [Parameter]
    public EventCallback<bool> OnAdminPanelShowChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnAdminPanelShowNavMenuChanged { get; set; }

    private bool _showAdminMenu = false;

    private void Navigate(string url)
    {
        bool showAdminPanel = url == "/admin-panel";

        OnAdminPanelShowChanged.InvokeAsync(showAdminPanel);

        NavigationManager.NavigateTo(url);
    }

    private void ToggleAdminMenu()
    {
        _showAdminMenu = !_showAdminMenu;
        OnAdminPanelShowNavMenuChanged.InvokeAsync(_showAdminMenu);
    }
}