@inherits LayoutComponentBase

@using MyHomeRamen.Blazor.Components.Layout.AppLayout

@inject ThemeProviderService ThemeProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <MudLayout Class="site-layout">
        <AppBar />
        <MudMainContent>
            <div class="app-page-content">
                @Body
            </div>
        </MudMainContent>
        <div class="site-footer">
            <Footer />
        </div>
    </MudLayout>
</CascadingAuthenticationState>

@code {
    private MudTheme _theme = default!;

    protected override void OnInitialized() => _theme = ThemeProvider.GetTheme();
}
