@using MyHomeRamen.Blazor.Common.Configuration
@using MyHomeRamen.Blazor.Features.Menu.Common.Services

@inject RestaurantConfiguration RestaurantConfiguration
@inject MenuNavigationService MenuNavigationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudAppBar Elevation="1">
    <MudStack Style="width:100%;">
        <MudText Typo="Typo.h3" Style="text-align:center; margin-top: 30px">@RestaurantConfiguration.RestaurantName</MudText>
        <MudStack Row="true" Style="align-items: center;">
            <MudSpacer />
            <MudSpacer />
            <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/"))">Home</MudButton>
            <MudMenu Label="Menu Management" Color="Color.Inherit" Variant="Variant.Text" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                <MudMenuItem OnClick="@(() => Navigate(MenuNavigationService.Routes.Admin.ProductsManagement))">Products Management</MudMenuItem>
                <MudMenuItem OnClick="@(() => Navigate(MenuNavigationService.Routes.Admin.IngredientsManagement))">Ingredients Management</MudMenuItem>
            </MudMenu>
            <MudSpacer />
            
            @if (_isAdmin)
            {
                <MudButton Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/admin-panel"))">Admin Panel</MudButton>
            }

            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Inherit" Variant="Variant.Text"/>

            <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Inherit" Variant="Variant.Text" OnClick="@(() => Navigate("/account"))">Account</MudIconButton>
            
            <Login />
            <MudSpacer />
        </MudStack>
    </MudStack>
</MudAppBar>

@code {
    private bool _isAuthenticated = false;
    private string _userName = string.Empty;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthenticationStateProvider.IsAuthenticated();
        _isAdmin = await AuthenticationStateProvider.IsAdmin();
    }

    private void Navigate(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}