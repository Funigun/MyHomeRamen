@inherits LayoutComponentBase

@using MyHomeRamen.Blazor.Common.Configuration

@inject RestaurantConfiguration RestaurantConfiguration
@inject AuthenticationStateProvider AuthStateProvider
@inject ThemeProviderService ThemeProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudStack>
            <span>@RestaurantConfiguration.RestaurantName - Customer</span>
            <MudStack Row="true" Style="width: 800px">
                <MudIconButton Href="/menu" Color="Color.Secondary" Edge="Edge.Start">Menu</MudIconButton>
                <MudIconButton Href="/orders" Color="Color.Secondary" Edge="Edge.Start">Order</MudIconButton>
                <MudIconButton Href="/reservations" Color="Color.Secondary" Edge="Edge.Start">Book table</MudIconButton>

                <MudSpacer />

                <MudIconButton Href="/shopping-cart" Color="Color.Secondary" Edge="Edge.Start">Basket</MudIconButton>
                <MudIconButton Href="/account" Color="Color.Secondary" Edge="Edge.Start">Account</MudIconButton>
                <MudIconButton Href="/account/signup" Color="Color.Secondary" Edge="Edge.Start">Sign Up</MudIconButton>
                <Login />
            </MudStack>
        </MudStack>
    </MudAppBar>

    <MudMainContent>
                <div style="justify-self:center; justify-items: center; align-items: center; min-width:25%">
                    @Body
                </div>
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = default!;

    protected override void OnInitialized() => _theme = ThemeProvider.GetTheme();
}
