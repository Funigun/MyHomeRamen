@inherits LayoutComponentBase

@using MyHomeRamen.Blazor.Common.Configuration
@using MyHomeRamen.Blazor.Components.Common

@inject ThemeProviderService ThemeProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Style="--mud-appbar-height: 175px; --footer-height: 181px;">
    <CustomerAppBar />

    <MudMainContent>
        <div style="min-height: 900px; padding: 96px 48px; padding-bottom: var(--footer-height);">
            @Body
        </div>
        
    </MudMainContent>

     <div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 999;">
        <Footer />
     </div>
</MudLayout>

@code {
    private MudTheme _theme = default!;

    protected override void OnInitialized() => _theme = ThemeProvider.GetTheme();
}
