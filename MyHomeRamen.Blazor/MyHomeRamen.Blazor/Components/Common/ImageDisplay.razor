@using MyHomeRamen.Blazor.Common.Models

@if (Image?.Url is { Length: > 0 })
{
    <img src="@Image.Url" alt="@Image.Alt" class="@Class" style="@Style" />
}
else
{
    <div class="@Class" style="display:flex; align-items:center; justify-content:center; @Style">
        <MudIcon Icon="@FallbackIcon" Size="Size.Large" />
    </div>
}

@code {
    [Parameter] public ImageModel? Image { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string FallbackIcon { get; set; } = Icons.Material.Filled.Image;
}
